# ==========================================
# 🔑 ARCHIPEL (YELLOWBANK) — CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. OPENAI CONFIGURATION
# ------------------------------------------
# Obtenez votre clé sur https://platform.openai.com/api-keys
OPENAI_API_KEY=votre_cle_openai_ici
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------
# 2. MICROSOFT SQL SERVER (MSSQL)
# ------------------------------------------
# Serveur (ex: localhost, 127.0.0.1, ou localhost\SQLEXPRESS)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ArchipelDB

# Authentification SQL Server :
MSSQL_USER=sa
MSSQL_PASSWORD=votre_mot_de_passe_ici

# Authentification Windows (mettre à 'yes' si vous utilisez votre session Windows au lieu de user/password) :
MSSQL_TRUSTED_CONNECTION=no

# Pilote ODBC installé sur Windows (vérifier dans 'Sources de données ODBC' si 17 ou 18)
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=no
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# ------------------------------------------
# 3. SÉCURITÉ & AUTHENTIFICATION (JWT)
# ------------------------------------------
JWT_SECRET_KEY=cle_secrete_aleatoire_a_changer_en_production_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------
# 4. URLs DES SERVICES
# ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_API_URL=http://127.0.0.1:8000
